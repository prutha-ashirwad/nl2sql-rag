# Copy to .env and adjust. Every setting has a working default.

# --- Language model provider -------------------------------------------------
# auto | anthropic | openai | deterministic
# "auto" uses whichever provider has a key, else the Knowledge Base planner.
LLM_PROVIDER=auto
# Unset uses the provider default (anthropic -> claude-opus-5, openai -> gpt-4o).
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/observability.db
SQL_DIALECT=sqlite
# The two must agree: the URL says where the data lives, the dialect says which SQL
# to write for it. For Postgres, install the driver with `pip install -e ".[postgres]"`
# and seed it with `make seed`:
# DATABASE_URL=postgresql+psycopg2://nl2sql:nl2sql@localhost:5432/observability
# SQL_DIALECT=postgres
EXECUTE_QUERIES=true
# Optional cap on rows returned. Unset returns every matching row.
# MAX_RESULT_ROWS=

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
LEXICAL_WEIGHT=0.5
RETRIEVAL_EXPAND_JOINS=true
# Dense backend. openai is the more accurate of the two and falls back to tfidf when
# no key is set; tfidf is local, free and needs no network.
EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# Index. Both are exact and rank identically; memory is faster at this corpus size.
# faiss is for a much larger Knowledge Base and needs `pip install -e '.[faiss]'`.
VECTOR_STORE=memory

# --- Workflow ----------------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2

# --- Tracing (optional) --------------------------------------------------------
# Records each workflow run in LangSmith. Needs a key from smith.langchain.com;
# with this off, nothing here is read and no data leaves the machine.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nl2sql-rag
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Web frontend ------------------------------------------------------------
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
